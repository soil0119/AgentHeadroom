{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soil0119.github.io/AgentHeadroom/adapter-output.schema.json",
  "title": "AgentHeadroom Adapter Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "accounts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "usageUrl": { "type": "string", "pattern": "^https://" },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "limits"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "label", "remainingPercent"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "remainingPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                      "resetsAt": { "type": "number", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
